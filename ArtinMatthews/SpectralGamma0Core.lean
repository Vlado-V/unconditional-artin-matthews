module

public import ArtinMatthews.SpectralPoincareL2
public import ArtinMatthews.SpectralPoincareLinear
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Arctan


set_option backward.privateInPublic true
@[expose] public section

/-!
A concrete Hilbert realization of the smooth compact-seed Γ₀(N) core.
Its components are the actual L² restrictions to inverse-translated modular
regions, indexed by the proved finite coset space.  This constructs the core;
it does not assert density in all automorphic measurable functions or a
spectral decomposition.
-/

noncomputable section
open Set MeasureTheory Filter
open scoped CompactlySupported MatrixGroups ContDiff

namespace ArtinMatthews

variable (𝒢 : Subgroup (GL (Fin 2) ℝ)) [𝒢.IsArithmetic]

/-- Linearity survives passage to actual almost-everywhere classes. -/
def arithmeticPoincareRegionLinear (r : GL (Fin 2) ℝ) :
    C_c(UpperHalfPlane, ℂ) →ₗ[ℂ] Lp ℂ 2 (volume.restrict ModularGroup.fd) where
  toFun ψ := arithmeticPoincareRegionLp 𝒢 ψ r
  map_add' ψ φ := by
    apply Lp.ext
    filter_upwards [arithmeticPoincareRegionLp_coeFn 𝒢 (ψ + φ) r,
      arithmeticPoincareRegionLp_coeFn 𝒢 ψ r,
      arithmeticPoincareRegionLp_coeFn 𝒢 φ r,
      Lp.coeFn_add (arithmeticPoincareRegionLp 𝒢 ψ r)
        (arithmeticPoincareRegionLp 𝒢 φ r)] with z hsum hψ hφ hadd
    rw [hadd]
    change _ = (arithmeticPoincareRegionLp 𝒢 ψ r) z + (arithmeticPoincareRegionLp 𝒢 φ r) z
    rw [hsum, hψ, hφ]
    exact congrArg (fun f : C(UpperHalfPlane, ℂ) => f (r • z))
      (arithmeticPoincareSeed_add 𝒢 ψ φ)
  map_smul' c ψ := by
    apply Lp.ext
    filter_upwards [arithmeticPoincareRegionLp_coeFn 𝒢 (c • ψ) r,
      arithmeticPoincareRegionLp_coeFn 𝒢 ψ r,
      Lp.coeFn_smul c (arithmeticPoincareRegionLp 𝒢 ψ r)] with z hsmul hψ hmul
    simp only [RingHom.id_apply]
    rw [hmul]
    change _ = c • (arithmeticPoincareRegionLp 𝒢 ψ r) z
    rw [hsmul, hψ]
    exact congrArg (fun f : C(UpperHalfPlane, ℂ) => f (r • z))
      (arithmeticPoincareSeed_smul 𝒢 c ψ)

/-- Actual compact smooth seeds, with smoothness expressed in upper-half-plane
coordinates.  Derivatives are those of the seed, not additional data. -/
def h2SmoothCompactSeeds : Submodule ℂ C_c(UpperHalfPlane, ℂ) where
  carrier := {ψ | ContDiffOn ℝ ∞ (fun z : ℂ => ψ (UpperHalfPlane.ofComplex z))
    {z : ℂ | 0 < z.im}}
  zero_mem' := by
    change ContDiffOn ℝ ∞ (fun _ : ℂ => (0 : ℂ)) _
    exact contDiffOn_const
  add_mem' := by
    intro ψ φ hψ hφ
    exact hψ.add hφ
  smul_mem' := by
    intro c ψ hψ
    exact contDiffOn_const.mul hψ

instance gamma0Coset_fintype (N : ℕ) [NeZero N] :
    Fintype (SL(2, ℤ) ⧸ CongruenceSubgroup.Gamma0 N) := Fintype.ofFinite _

abbrev Gamma0RegionL2 (N : ℕ) :=
  PiLp 2 (fun _ : SL(2, ℤ) ⧸ CongruenceSubgroup.Gamma0 N =>
    Lp ℂ 2 (volume.restrict ModularGroup.fd))

/-- The mass map is evaluated on the actual inverse coset representatives. -/
def gamma0SeedMass (N : ℕ) [NeZero N] :
    C_c(UpperHalfPlane, ℂ) →ₗ[ℂ] Gamma0RegionL2 N :=
  (WithLp.linearEquiv 2 ℂ _).symm.toLinearMap.comp <|
    LinearMap.pi (fun q : SL(2, ℤ) ⧸ CongruenceSubgroup.Gamma0 N =>
      arithmeticPoincareRegionLinear
        (CongruenceSubgroup.Gamma0 N : Subgroup (GL (Fin 2) ℝ))
        (Matrix.SpecialLinearGroup.mapGL ℝ q.out⁻¹))

def gamma0SmoothSeedMass (N : ℕ) [NeZero N] :
    h2SmoothCompactSeeds →ₗ[ℂ] Gamma0RegionL2 N :=
  (gamma0SeedMass N).comp h2SmoothCompactSeeds.subtype

/-- The closed Hilbert mass space generated by actual smooth periodizations. -/
def gamma0CompactCoreL2 (N : ℕ) [NeZero N] : Submodule ℂ (Gamma0RegionL2 N) :=
  (gamma0SmoothSeedMass N).range.topologicalClosure

instance gamma0CompactCoreL2_complete (N : ℕ) [NeZero N] :
    CompleteSpace (gamma0CompactCoreL2 N) :=
  (Submodule.isClosed_topologicalClosure _).isComplete.completeSpace_coe

/-- Every generating vector has the claimed actual automorphic representative. -/
theorem gamma0SeedMass_coeFn (N : ℕ) [NeZero N] (ψ : C_c(UpperHalfPlane, ℂ))
    (q : SL(2, ℤ) ⧸ CongruenceSubgroup.Gamma0 N) :
    ((gamma0SeedMass N ψ) q : UpperHalfPlane → ℂ) =ᵐ[volume.restrict ModularGroup.fd]
      (fun z => gamma0PoincareSeed N ψ (q.out⁻¹ • z)) :=
  arithmeticPoincareRegionLp_coeFn _ ψ (Matrix.SpecialLinearGroup.mapGL ℝ q.out⁻¹)

theorem gamma0SmoothSeedMass_mem_core (N : ℕ) [NeZero N] (ψ : h2SmoothCompactSeeds) :
    gamma0SmoothSeedMass N ψ ∈ gamma0CompactCoreL2 N :=
  Submodule.le_topologicalClosure _ ⟨ψ, rfl⟩

/-- Real smoothness of every actual representative in the generating core. -/
theorem gamma0SmoothSeed_representative_smooth (N : ℕ) [NeZero N]
    (ψ : h2SmoothCompactSeeds) :
    ContDiffOn ℝ ∞
      (fun z : ℂ => gamma0PoincareSeed N ψ.val (UpperHalfPlane.ofComplex z))
      {z : ℂ | 0 < z.im} :=
  gamma0PoincareSeed_smooth N ψ.val ψ.property

end ArtinMatthews
