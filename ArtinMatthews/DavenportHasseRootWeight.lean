module

public import ArtinMatthews.DavenportHassePolynomialWeight
public import ArtinMatthews.FiniteFieldNormCharacter


set_option backward.privateInPublic true
@[expose] public section

/-! Each actual norm/trace lifted Gauss summand is the power of the
minimal-polynomial weight. The exponent is the relative degree over the
field generated by the element; all norm and trace identities are proved
through the actual simple extension. -/
namespace ArtinMatthews.DavenportHasse
open Polynomial IntermediateField
open scoped Classical BigOperators
noncomputable section
variable (F E : Type*) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E]

theorem norm_trace_weight_minpoly (χ : MulChar F ℂ) (ψ : AddChar F ℂ) (x : E) :
    χ (Algebra.norm F x) * ψ (Algebra.trace F E x) =
      polynomialWeight χ ψ (minpoly F x) ^ Module.finrank F⟮x⟯ E := by
  have hx : IsIntegral F x := IsIntegral.of_finite F x
  have hb := polynomialWeight_minpoly_powerBasis (adjoin.powerBasis hx) χ ψ
  have hbase : polynomialWeight χ ψ (minpoly F x) =
      χ (Algebra.norm F (AdjoinSimple.gen F x)) *
        ψ (Algebra.trace F F⟮x⟯ (AdjoinSimple.gen F x)) := by
    simpa only [adjoin.powerBasis_gen,minpoly_gen] using hb
  rw [hbase,mul_pow,← map_pow,← AddChar.map_nsmul_eq_pow,
    ← Algebra.norm_eq_norm_adjoin F x,← trace_eq_trace_adjoin F x]

theorem minpoly_degree_times_relativeDegree (x : E) :
    (minpoly F x).natDegree * Module.finrank F⟮x⟯ E = Module.finrank F E := by
  rw [← adjoin.finrank (IsIntegral.of_finite F x)]
  exact Module.finrank_mul_finrank F F⟮x⟯ E

variable [Fintype E]

theorem lifted_gauss_eq_minpoly_sum (χ : MulChar F ℂ) (ψ : AddChar F ℂ) :
    gaussSum (FiniteFieldCharacter.normLift F E χ) (FiniteFieldCharacter.traceLift F E ψ) =
      ∑ x : E, polynomialWeight χ ψ (minpoly F x)^Module.finrank F⟮x⟯ E := by
  unfold gaussSum
  apply Finset.sum_congr rfl
  intro x _
  exact norm_trace_weight_minpoly F E χ ψ x

end
end ArtinMatthews.DavenportHasse
