module

public import ArtinMatthews.SourceKPAdelicExceptionalRational


set_option backward.privateInPublic true
@[expose] public section

/-! The exceptional character extends to the actual abelian subgroup
generated by the central cube torus and rational diagonal lifts,
with value one on every rational diagonal. The extension is by
descent through the proved kernel, so its value is independent of
the two-factor presentation. -/

namespace ArtinMatthews
open NumberField Matrix
open scoped NumberField AdeleRing MatrixGroups
noncomputable section

variable (K : Type) [Field K] [NumberField K] {ζ : K} (hζ : IsPrimitiveRoot ζ 12)

theorem sourceKPAdelicCubeTorus_mul_comm (x y : sourceKPAdelicCubeTorus K hζ) : x * y = y * x := by
  let e := sourceKPAdelicCubeTorusEquiv K hζ
  apply e.symm.injective
  rw [map_mul, map_mul, mul_comm (e.symm x) (e.symm y)]

theorem sourceKPAdelicCubeTorus_commute_diagonal (x : sourceKPAdelicCubeTorus K hζ) (y : IdeleGroup (𝓞 K) K) :
    Commute x.val (sourceKPAdelicProjectiveDiagonalLift K hζ y) := by
  obtain ⟨p, rfl⟩ := (sourceKPAdelicCubeTorusEquiv K hζ).surjective x
  rw [sourceKPAdelicCubeTorusEquiv_val]
  change Commute (sourceKPAdelicProjectiveCenter K hζ p.1 * sourceKPAdelicProjectiveDiagonalLift K hζ p.2.val)
    (sourceKPAdelicProjectiveDiagonalLift K hζ y)
  obtain ⟨z, hz⟩ := p.2.property
  change z ^ (3 : ℕ) = p.2.val at hz
  rw [← hz]
  exact (sourceKPAdelicProjectiveCenter_commute K hζ p.1 (sourceKPAdelicProjectiveDiagonalLift K hζ y)).mul_left
    (sourceKPAdelicProjectiveDiagonalLift_cube_commute K hζ z y)

def sourceKPAdelicRationalDiagonalLift : Kˣ →* SourceKPAdelicProjective K hζ :=
  (sourceKPAdelicProjectiveRationalLift K hζ).comp (sourceKPProjectiveDiagonalHom K)

theorem sourceKPAdelicCubeTorus_commute_rational (x : sourceKPAdelicCubeTorus K hζ) (y : Kˣ) :
    Commute x.val (sourceKPAdelicRationalDiagonalLift K hζ y) := by
  change Commute x.val (sourceKPAdelicProjectiveRationalLift K hζ (sourceKPProjectiveDiagonalHom K y))
  rw [sourceKPAdelicProjectiveRationalLift_diagonal]
  exact sourceKPAdelicCubeTorus_commute_diagonal K hζ x _

def sourceKPAdelicRationalCubeJoin :
    sourceKPAdelicCubeTorus K hζ × Kˣ →* SourceKPAdelicProjective K hζ where
  toFun p := p.1.val * sourceKPAdelicRationalDiagonalLift K hζ p.2
  map_one' := by
    change 1 * sourceKPAdelicRationalDiagonalLift K hζ 1 = 1
    rw [map_one, one_mul]
  map_mul' x y := by
    change x.1.val * y.1.val * sourceKPAdelicRationalDiagonalLift K hζ (x.2 * y.2) = _
    rw [map_mul]
    exact (sourceKPAdelicCubeTorus_commute_rational K hζ y.1 x.2).mul_mul_mul_comm _ _

def sourceKPAdelicRationalCubeTorus : Subgroup (SourceKPAdelicProjective K hζ) :=
  (sourceKPAdelicRationalCubeJoin K hζ).range

theorem sourceKPAdelicRationalCubeTorus_mul_comm (x y : sourceKPAdelicRationalCubeTorus K hζ) : x * y = y * x := by
  obtain ⟨p, hp⟩ := x.property
  obtain ⟨q, hq⟩ := y.property
  apply Subtype.ext
  change x.val * y.val = y.val * x.val
  rw [← hp, ← hq, ← map_mul, ← map_mul]
  exact congrArg (sourceKPAdelicRationalCubeJoin K hζ)
    (Prod.ext (sourceKPAdelicCubeTorus_mul_comm K hζ p.1 q.1) (mul_comm p.2 q.2))

private def sourceKPAdelicRationalCubeCharacterPair : sourceKPAdelicCubeTorus K hζ × Kˣ →* ℂˣ :=
  (sourceKPAdelicExceptionalCharacter K hζ).comp (MonoidHom.fst _ _)

private theorem sourceKPAdelicRationalCubeCharacter_ker :
    (sourceKPAdelicRationalCubeJoin K hζ).ker ≤ (sourceKPAdelicRationalCubeCharacterPair K hζ).ker := by
  intro p hp
  let r := sourceKPAdelicRationalDiagonalLift K hζ
  change p.1.val * r p.2 = 1 at hp
  have he := congrArg (fun g : SourceKPAdelicProjective K hζ => g * (r p.2)⁻¹) hp
  rw [mul_inv_cancel_right, one_mul] at he
  have hr : r p.2⁻¹ = p.1.val := by rw [map_inv, he]
  change sourceKPAdelicExceptionalCharacter K hζ p.1 = 1
  exact sourceKPAdelicExceptionalCharacter_rational K hζ (sourceKPProjectiveDiagonalHom K p.2⁻¹) p.1 hr

def sourceKPAdelicRationalCubeCharacter : sourceKPAdelicRationalCubeTorus K hζ →* ℂˣ :=
  (QuotientGroup.lift (sourceKPAdelicRationalCubeJoin K hζ).ker
    (sourceKPAdelicRationalCubeCharacterPair K hζ) (sourceKPAdelicRationalCubeCharacter_ker K hζ)).comp
      (QuotientGroup.quotientKerEquivRange (sourceKPAdelicRationalCubeJoin K hζ)).symm.toMonoidHom

theorem sourceKPAdelicRationalCubeCharacter_join (p : sourceKPAdelicCubeTorus K hζ × Kˣ) :
    sourceKPAdelicRationalCubeCharacter K hζ
      ⟨sourceKPAdelicRationalCubeJoin K hζ p, ⟨p, rfl⟩⟩ =
      sourceKPAdelicExceptionalCharacter K hζ p.1 := by
  let m := sourceKPAdelicRationalCubeJoin K hζ
  let e := QuotientGroup.quotientKerEquivRange m
  have he : e (QuotientGroup.mk' m.ker p) = ⟨m p, ⟨p, rfl⟩⟩ := rfl
  change (QuotientGroup.lift m.ker (sourceKPAdelicRationalCubeCharacterPair K hζ)
    (sourceKPAdelicRationalCubeCharacter_ker K hζ)) (e.symm (⟨m p, ⟨p, rfl⟩⟩ : m.range)) = _
  rw [← he, MulEquiv.symm_apply_apply]
  rfl

end
end ArtinMatthews
