/-! The algebraic cyclic representation generated by the genuine tame
spherical vector. Stable Jacquet integration gives an actual linear
functional on that whole representation. Its coordinate-zero
functional is nonzero and has the standard upper-root character. -/

namespace ArtinMatthews
open NumberField IsDedekindDomain StandardAdelic AllowedGenerators QuadraticWeil
open scoped NumberField SourcePhysical MatrixGroups
noncomputable section

variable (K : Type) [Field K] [NumberField K] {ζ : K} (hζ : IsPrimitiveRoot ζ 12)
    (S₀ : Finset (HeightOneSpectrum (𝓞 K))) (P : SourceExteriorPrime K S₀)

local notation "L" => P.val.adicCompletion K
local notation "G₀" => SourceFiniteKP2Projective K hζ P.val
local notation "I₀" => sourceKPTameExteriorInducedSpace K hζ S₀ P
local notation "f₀" => sourceKPTameExteriorSphericalSection K hζ S₀ P
local notation "ρ₀" => sourceKPTameExteriorInducedRepresentation K hζ S₀ P
local notation "l₀" => sourceFiniteKP2ProjectiveLift K hζ P.val
local notation "ψ₀" => localFiniteCharacter K P.val

def sourceKPTameSphericalCyclicSpace : Submodule ℂ I₀ :=
  Submodule.span ℂ (Set.range (fun g : G₀ => ρ₀ g f₀))

local notation "C₀" => sourceKPTameSphericalCyclicSpace K hζ S₀ P

theorem sourceKPTameSphericalCyclicSpace_invariant (g : G₀) (f : I₀) (hf : f ∈ C₀) :
    ρ₀ g f ∈ C₀ := by
  let A := Set.range (fun k : G₀ => ρ₀ k f₀)
  have hA : (ρ₀ g) '' A ⊆ A := by
    rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
    refine ⟨g * k, ?_⟩
    change ρ₀ (g * k) f₀ = ρ₀ g (ρ₀ k f₀)
    rw [map_mul ρ₀]
    rfl
  have h : Submodule.map (ρ₀ g) C₀ ≤ C₀ := by
    change (Submodule.span ℂ A).map (ρ₀ g) ≤ Submodule.span ℂ A
    rw [Submodule.map_span]
    exact Submodule.span_mono hA
  exact h ⟨f, hf, rfl⟩

def sourceKPTameSphericalCyclicRepresentation : Representation ℂ G₀ C₀ where
  toFun g := (ρ₀ g).restrict (sourceKPTameSphericalCyclicSpace_invariant K hζ S₀ P g)
  map_one' := by
    apply LinearMap.ext
    intro f
    apply Subtype.ext
    change ρ₀ 1 f.val = f.val
    rw [map_one]
    rfl
  map_mul' g k := by
    apply LinearMap.ext
    intro f
    apply Subtype.ext
    change ρ₀ (g * k) f.val = ρ₀ g (ρ₀ k f.val)
    rw [map_mul ρ₀]
    rfl

def sourceKPTameCyclicSphericalVector : C₀ :=
  ⟨f₀, Submodule.subset_span ⟨1, by
    change ρ₀ 1 f₀ = f₀
    rw [map_one]
    rfl⟩⟩

variable (hS : standardWeilBadPlaces K ⊆ sourceHilbertSet K S₀)

include hS in
theorem sourceKPTameSphericalCyclicSpace_le_stable :
    C₀ ≤ sourceKPTameJacquetStableSpace K hζ S₀ P := by
  apply Submodule.span_le.mpr
  rintro f ⟨g, rfl⟩
  exact sourceKPTameJacquetHasStableValue_spherical_translate K hζ S₀ P hS g

def sourceKPTameCyclicJacquetMap : C₀ →ₗ[ℂ] (ZMod 3 → ℂ) :=
  (sourceKPTameJacquetStableMap K hζ S₀ P).comp
    (Submodule.inclusion (sourceKPTameSphericalCyclicSpace_le_stable K hζ S₀ P hS))

theorem sourceKPTameCyclicJacquetMap_hasStableValue (f : C₀) :
    sourceKPTameJacquetHasStableValue K hζ S₀ P f.val (sourceKPTameCyclicJacquetMap K hζ S₀ P hS f) :=
  sourceKPTameJacquetStableMap_hasStableValue K hζ S₀ P
    ((Submodule.inclusion (sourceKPTameSphericalCyclicSpace_le_stable K hζ S₀ P hS)) f)

theorem sourceKPTameCyclicJacquetMap_upper (f : C₀) (t : L) :
    sourceKPTameCyclicJacquetMap K hζ S₀ P hS
        (sourceKPTameSphericalCyclicRepresentation K hζ S₀ P (l₀ (sourceGL2Upper t)) f) =
      ψ₀ t • sourceKPTameCyclicJacquetMap K hζ S₀ P hS f :=
  sourceKPTameJacquetHasStableValue_unique K hζ S₀ P
    (sourceKPTameCyclicJacquetMap_hasStableValue K hζ S₀ P hS _)
    (sourceKPTameJacquetHasStableValue_upper K hζ S₀ P
      (sourceKPTameCyclicJacquetMap_hasStableValue K hζ S₀ P hS f) t)

theorem sourceKPTameCyclicJacquetMap_spherical :
    sourceKPTameCyclicJacquetMap K hζ S₀ P hS (sourceKPTameCyclicSphericalVector K hζ S₀ P) =
      sourceKPTameJacquetStable K hζ S₀ P 0 := by
  have h := sourceKPTameJacquetHasStableValue_diagonal_nonnegative K hζ S₀ P hS 0
  have hπ : (sourceKPTameExteriorUniformizer K hζ S₀ P) ^ ((0 : ℕ) : ℤ) = 1 := zpow_zero _
  have hdiag : sourceGL2Diagonal (1 : Lˣ) = 1 := (sourceGL2DiagonalHom L).map_one
  have hl : l₀ 1 = 1 := (sourceFiniteKP2ProjectiveMk K hζ P.val).map_one
  rw [hπ, hdiag, hl, map_one ρ₀] at h
  exact sourceKPTameJacquetHasStableValue_unique K hζ S₀ P
    (sourceKPTameCyclicJacquetMap_hasStableValue K hζ S₀ P hS _) h

def sourceKPTameCyclicWhittaker : C₀ →ₗ[ℂ] ℂ :=
  (LinearMap.proj (0 : ZMod 3)).comp (sourceKPTameCyclicJacquetMap K hζ S₀ P hS)

theorem sourceKPTameCyclicWhittaker_upper (f : C₀) (t : L) :
    sourceKPTameCyclicWhittaker K hζ S₀ P hS
        (sourceKPTameSphericalCyclicRepresentation K hζ S₀ P (l₀ (sourceGL2Upper t)) f) =
      ψ₀ t * sourceKPTameCyclicWhittaker K hζ S₀ P hS f := by
  change (sourceKPTameCyclicJacquetMap K hζ S₀ P hS
    (sourceKPTameSphericalCyclicRepresentation K hζ S₀ P (l₀ (sourceGL2Upper t)) f)) 0 = _
  rw [sourceKPTameCyclicJacquetMap_upper K hζ S₀ P hS f t]
  rfl

theorem sourceKPTameCyclicWhittaker_spherical :
    sourceKPTameCyclicWhittaker K hζ S₀ P hS (sourceKPTameCyclicSphericalVector K hζ S₀ P) = 1 := by
  change (sourceKPTameCyclicJacquetMap K hζ S₀ P hS (sourceKPTameCyclicSphericalVector K hζ S₀ P)) 0 = 1
  rw [sourceKPTameCyclicJacquetMap_spherical, sourceKPTameJacquetStable_zero_at_zero K hζ S₀ P hS]

end
