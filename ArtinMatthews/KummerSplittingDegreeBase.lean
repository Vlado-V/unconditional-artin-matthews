/-!
# Concrete fields and roots for the prime Kummer degree calculation

The cyclotomic field is an actual intermediate field of `ℂ / ℚ` generated by
the standard exponential root of unity. A radical is chosen from the algebraic
closure of `ℂ`. Both definitions are total in the exponent; their mathematical
properties are asserted only for positive exponents.
-/

namespace ArtinMatthews

/-- The standard complex root of unity of order `q`, for positive `q`. -/
noncomputable def primeCyclotomicRoot (q : ℕ) : ℂ :=
  Complex.exp (2 * Real.pi * Complex.I / q)

/-- The concrete cyclotomic subfield of `ℂ`, defined for every natural `q`. -/
noncomputable def primeCyclotomicField (q : ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {primeCyclotomicRoot q}

/-- A chosen complex `q`th root of the integer base. The zero-exponent value
is merely a total-definition convention and is never used as a radical. -/
noncomputable def primeRadicalRoot (q : ℕ) (a : ℤ) : ℂ :=
  if hq : 0 < q then Classical.choose (IsAlgClosed.exists_pow_nat_eq (a : ℂ) hq) else 0

theorem primeRadicalRoot_pow {q : ℕ} (hq : 0 < q) (a : ℤ) :
    primeRadicalRoot q a ^ q = (a : ℂ) := by
  simpa only [primeRadicalRoot, dite_eq_left hq] using
    Classical.choose_spec (IsAlgClosed.exists_pow_nat_eq (a : ℂ) hq)

theorem primeRadicalRoot_ne_zero {q : ℕ} (hq : 0 < q) {a : ℤ} (ha : a ≠ 0) :
    primeRadicalRoot q a ≠ 0 := by
  intro hz
  have h := primeRadicalRoot_pow hq a
  rw [hz, zero_pow hq.ne'] at h
  exact ha (by exact_mod_cast h.symm)

theorem primeCyclotomicRoot_isPrimitiveRoot {q : ℕ} (hq : 0 < q) :
    IsPrimitiveRoot (primeCyclotomicRoot q) q :=
  Complex.isPrimitiveRoot_exp q hq.ne'

theorem primeCyclotomicRoot_pow {q : ℕ} (hq : 0 < q) :
    primeCyclotomicRoot q ^ q = 1 :=
  (primeCyclotomicRoot_isPrimitiveRoot hq).pow_eq_one

theorem primeCyclotomicRoot_mem (q : ℕ) :
    primeCyclotomicRoot q ∈ primeCyclotomicField q :=
  IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)

instance primeCyclotomicField_isCyclotomicExtension (q : ℕ) [NeZero q] :
    IsCyclotomicExtension {q} ℚ (primeCyclotomicField q) :=
  (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
    q ℚ ℂ (primeCyclotomicField q)
    (primeCyclotomicRoot_isPrimitiveRoot (NeZero.pos q))).mpr rfl

noncomputable instance primeCyclotomicField_finiteDimensional (q : ℕ) [NeZero q] :
    FiniteDimensional ℚ (primeCyclotomicField q) :=
  IsCyclotomicExtension.finite_of_singleton q ℚ (primeCyclotomicField q)

noncomputable instance primeCyclotomicField_isGalois (q : ℕ) [NeZero q] :
    IsGalois ℚ (primeCyclotomicField q) :=
  IsCyclotomicExtension.isGalois {q} ℚ (primeCyclotomicField q)

/-- The degree of the actual prime cyclotomic field is `q - 1`. -/
theorem finrank_primeCyclotomicField {q : ℕ} (hq : q.Prime) :
    Module.finrank ℚ (primeCyclotomicField q) = q - 1 := by
  let : NeZero q := ⟨hq.ne_zero⟩
  simpa only [Nat.totient_prime hq] using
    (IsCyclotomicExtension.finrank (primeCyclotomicField q)
      (Polynomial.cyclotomic.irreducible_rat hq.pos))

/-- Every `q`th root of unity belongs to the concrete cyclotomic field. -/
theorem root_of_unity_mem_primeCyclotomicField {q : ℕ} (hq : 0 < q) {z : ℂ}
    (hz : z ^ q = 1) : z ∈ primeCyclotomicField q := by
  let : NeZero q := ⟨hq.ne'⟩
  obtain ⟨j, _, hj⟩ := (primeCyclotomicRoot_isPrimitiveRoot hq).eq_pow_of_pow_eq_one hz
  rw [← hj]
  exact (primeCyclotomicField q).pow_mem (primeCyclotomicRoot_mem q) j

theorem primeCyclotomicField_le_iff (q : ℕ) (K : IntermediateField ℚ ℂ) :
    primeCyclotomicField q ≤ K ↔ primeCyclotomicRoot q ∈ K := by
  rw [primeCyclotomicField, IntermediateField.adjoin_le_iff]
  exact Set.singleton_subset_iff

end ArtinMatthews
