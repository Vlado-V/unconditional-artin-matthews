module

public import OAI.NumberTheory.DirichletL.Arithmetic.IdealMobius


set_option backward.privateInPublic true
@[expose] public section

/-! The actual Eisenstein angular ideal character.  It is zero on the
ramified support and agrees with z/|z| on principal ideals generated by
elements congruent to one modulo three. -/
namespace ArtinMatthews.AngularLambda
open OAI OAI.ActualEisensteinCubic OAI.CompletedGauss OAI.ConcreteTraceCRT
open scoped Classical
noncomputable section

abbrev BaseField := CyclotomicField 3 ℚ
abbrev BaseIntegers := NumberField.RingOfIntegers BaseField

def complexAngular (z : ℂ) : ℂ := z / (‖z‖ : ℂ)

def complexAngularHom : ℂ →*₀ ℂ where
  toFun := complexAngular
  map_zero' := by simp [complexAngular]
  map_one' := by simp [complexAngular]
  map_mul' z w := by
    simp only [complexAngular,norm_mul,Complex.ofReal_mul]
    exact mul_div_mul_comm z w _ _

theorem complexAngular_norm {z : ℂ} (hz : z ≠ 0) : ‖complexAngular z‖ = 1 := by
  rw [complexAngular,norm_div,Complex.norm_real,Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg z)]
  exact div_self (norm_ne_zero_iff.mpr hz)

def eisensteinAngularIdeal : Ideal BaseIntegers →*₀ ℂ :=
  complexAngularHom.comp (eisEmbedding.toMonoidWithZeroHom.comp primaryGeneratorHom)

theorem eisensteinAngularIdeal_apply (I : Ideal BaseIntegers) :
    eisensteinAngularIdeal I = complexAngular (eisEmbedding (primaryGenerator I)) := rfl

theorem eisensteinAngularIdeal_norm (I : Ideal BaseIntegers)
    (hI : primaryGenerator I ≠ 0) : ‖eisensteinAngularIdeal I‖ = 1 := by
  apply complexAngular_norm
  exact eisEmbedding_ne_zero hI

theorem eisensteinAngularIdeal_principal (a : BaseIntegers) (ha : a ≠ 0)
    (hthree : (3 : BaseIntegers) ∣ a-1) :
    eisensteinAngularIdeal (Ideal.span {a}) = complexAngular (eisEmbedding a) := by
  rw [eisensteinAngularIdeal_apply,primaryGenerator_span a ha
    (lambda_sq_dvd_three.trans hthree)]

theorem primaryGenerator_ne_zero_of_coprime (I : Ideal BaseIntegers) (hI : I ≠ ⊥)
    (hc : IsCoprime I (Ideal.span {lambda})) : primaryGenerator I ≠ 0 := by
  have hI0 : I ≠ 0 := hI
  rw [primaryGenerator,ite_eq_right hI0]
  apply Multiset.prod_ne_zero
  intro hz
  obtain ⟨P,hP,hzero⟩ := Multiset.mem_map.mp hz
  have hprime := UniqueFactorizationMonoid.prime_of_normalized_factor P hP
  let : P.IsMaximal := (Ideal.isPrime_of_prime hprime).isMaximal hprime.ne_zero
  apply primaryPrime_ne_zero P _ hzero
  intro hlam
  have hIP : I ≤ P := ((Ideal.mem_normalizedFactors_iff hI0).mp hP).2
  have hLP : Ideal.span {lambda} ≤ P := (Ideal.span_singleton_le_iff_mem P).mpr hlam
  have htop : (⊤ : Ideal BaseIntegers) ≤ P := hc.sup_eq ▸ sup_le hIP hLP
  exact (inferInstance : P.IsMaximal).ne_top (top_unique htop)

theorem eisensteinAngularIdeal_norm_of_coprime (I : Ideal BaseIntegers) (hI : I ≠ ⊥)
    (hc : IsCoprime I (Ideal.span {lambda})) : ‖eisensteinAngularIdeal I‖ = 1 :=
  eisensteinAngularIdeal_norm I (primaryGenerator_ne_zero_of_coprime I hI hc)

end
end ArtinMatthews.AngularLambda
