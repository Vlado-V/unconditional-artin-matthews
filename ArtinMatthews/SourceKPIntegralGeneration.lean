/-! The genuine integral subgroup is generated by integral root
elements, unit diagonals and scalars, and the Weyl element. All
divisions in the reduction are by a proved unit in the bottom row. -/

namespace ArtinMatthews
open Matrix Matrix.GeneralLinearGroup
open scoped MatrixGroups
noncomputable section
variable {F Γ : Type*} [Field F] [LinearOrderedCommGroupWithZero Γ]
    (ν : Valuation F Γ)

theorem sourceKPIntegralMatrix_upper (x : F) (hx : ν x ≤ 1) :
    SourceKPIntegralMatrix ν (sourceGL2Upper x) := by
  refine ⟨?_, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> simp [sourceGL2Upper, hx]
  · rw [sourceGL2Upper_det, Units.val_one, map_one]

theorem sourceKPIntegralMatrix_diagonal (u : Fˣ) (hu : ν (u : F) = 1) :
    SourceKPIntegralMatrix ν (sourceGL2Diagonal u) := by
  refine ⟨?_, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> simp [sourceGL2Diagonal, hu]
  · rw [sourceGL2Diagonal_det, hu]

theorem sourceKPIntegralMatrix_scalar (u : Fˣ) (hu : ν (u : F) = 1) :
    SourceKPIntegralMatrix ν (GeneralLinearGroup.scalar (Fin 2) u) := by
  refine ⟨?_, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> simp [GeneralLinearGroup.coe_scalar, hu]
  · rw [sourceGL2_scalar_det, Units.val_pow_eq_pow_val, map_pow, hu, one_pow]

theorem sourceKPIntegralMatrix_weyl : SourceKPIntegralMatrix ν (sourceGL2Weyl : GL (Fin 2) F) := by
  refine ⟨?_, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> simp [sourceGL2Weyl]
  · rw [sourceGL2Weyl_det]
    change ν (-1) = 1
    simp

theorem sourceKPIntegralMatrix_triangular_factor (g : GL (Fin 2) F)
    (hg : SourceKPIntegralMatrix ν g) (hc : g 1 0 = 0) :
    ∃ (x : F) (u d : Fˣ), ν x ≤ 1 ∧ ν (u : F) = 1 ∧ ν (d : F) = 1 ∧
      g = sourceGL2Upper x * sourceGL2Diagonal u * GeneralLinearGroup.scalar (Fin 2) d := by
  obtain ⟨x, u, d, hfactor⟩ := sourceGL2_triangular_factor g hc
  have hd : ν (g 1 1) = 1 := (sourceKPIntegralMatrix_bottom_unit ν hg).resolve_left (by
    rw [hc, map_zero]
    exact zero_ne_one)
  have hdv : (d : F) = g 1 1 := by
    rw [hfactor]
    simp [sourceGL2Upper, sourceGL2Diagonal, Matrix.mul_apply,
      GeneralLinearGroup.coe_scalar, Matrix.diagonal_apply]
  have hxd : x * (d : F) = g 0 1 := by
    rw [hfactor]
    simp [sourceGL2Upper, sourceGL2Diagonal, Matrix.mul_apply,
      GeneralLinearGroup.coe_scalar, Matrix.diagonal_apply]
  have hd' : ν (d : F) = 1 := hdv ▸ hd
  have hx := hg.entries 0 1
  rw [← hxd, map_mul, hd', mul_one] at hx
  have hdet : GeneralLinearGroup.det g = u * d ^ 2 := by
    rw [hfactor, map_mul, map_mul, sourceGL2Upper_det, sourceGL2Diagonal_det, sourceGL2_scalar_det, one_mul]
  have hu := hg.det_unit
  rw [hdet, Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, hd', one_pow, mul_one] at hu
  exact ⟨x, u, d, hx, hu, hd', hfactor⟩

theorem sourceKPIntegralMatrix_weyl_factor (g : GL (Fin 2) F)
    (hg : SourceKPIntegralMatrix ν g) (hc : ν (g 1 0) = 1) :
    ∃ (b : GL (Fin 2) F) (x : F), SourceKPIntegralMatrix ν b ∧ b 1 0 = 0 ∧ ν x ≤ 1 ∧
      g = b * sourceGL2Weyl * sourceGL2Upper x := by
  have hc0 : g 1 0 ≠ 0 := by
    intro h
    rw [h, map_zero] at hc
    exact zero_ne_one hc
  let x := g 1 1 / g 1 0
  let b := g * sourceGL2Upper (-x) * sourceGL2Weyl
  have hx : ν x ≤ 1 := by
    dsimp only [x]
    rw [map_div₀, hc, div_one]
    exact hg.entries 1 1
  have hnx : ν (-x) ≤ 1 := by rwa [ν.map_neg]
  have hb : SourceKPIntegralMatrix ν b := sourceKPIntegralMatrix_mul ν
    (sourceKPIntegralMatrix_mul ν hg (sourceKPIntegralMatrix_upper ν (-x) hnx))
    (sourceKPIntegralMatrix_weyl ν)
  refine ⟨b, x, hb, ?_, hx, ?_⟩
  · change (g * sourceGL2Upper (-x) * (sourceGL2Weyl : GL (Fin 2) F)) 1 0 = 0
    rw [sourceGL2_right_weyl_bottom_left, sourceGL2_right_upper_bottom_right]
    dsimp only [x]
    rw [mul_neg, ← mul_div_assoc, mul_div_cancel_left₀ _ hc0, neg_add_cancel]
  · symm
    calc
      _ = g * ((sourceGL2Upper (-x) * ((sourceGL2Weyl : GL (Fin 2) F) * sourceGL2Weyl)) *
          sourceGL2Upper x) := by simp only [b, mul_assoc]
      _ = g := by
        rw [sourceGL2Weyl_square, mul_one, sourceGL2Upper_mul, neg_add_cancel, sourceGL2Upper_zero, mul_one]

end
end ArtinMatthews
