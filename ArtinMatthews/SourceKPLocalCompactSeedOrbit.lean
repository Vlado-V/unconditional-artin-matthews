/-! The local Borel span of a finite family of actual torus values is
generated by the original family and the genuine local cube classes. -/

namespace ArtinMatthews
open NumberField IsDedekindDomain
open scoped Classical
noncomputable section

variable (K : Type) [Field K] [NumberField K] {ζ : K} (hζ : IsPrimitiveRoot ζ 12)
    (P : HeightOneSpectrum (𝓞 K))

local notation "B" => SourceFiniteKPProjectiveBorel K hζ P
local notation "G" => SourceFiniteKP2Projective K hζ P
local notation "C" => sourceKPLocalCompactCover K hζ P
local notation "J" => sourceKPLocalCompactDeep K hζ P
local notation "Q" => SourceKPLocalCompactCubeClasses K P
local notation "V" => SourceKPAdelicTorusInducedSpace K hζ
local notation "ρ" => sourceKPAdelicLocalBorelRepresentation K hζ P
local notation "d₀" => sourceFiniteKPProjectiveBorelDiagonal K hζ P

local instance sourceKPLocalCompactSeedAmbientAddCommGroup (s : ℂ) : AddCommGroup (V s) :=
  Submodule.addCommGroup _

def sourceKPLocalCompactSeedOrbit {A : Type*} (s : ℂ) (v : A → V s) : Submodule ℂ (V s) :=
  Submodule.span ℂ (Set.range (fun a : B × A => ρ s a.1 (v a.2)))

theorem sourceKPLocalCompactSeedOrbit_translate_mem {A : Type*} (s : ℂ) (v : A → V s)
    (b : B) (i : A) : ρ s b (v i) ∈ sourceKPLocalCompactSeedOrbit K hζ P s v :=
  Submodule.subset_span ⟨(b,i),rfl⟩

theorem sourceKPLocalCompactSeedOrbit_eq_cube_span {A : Type*} (s : ℂ) (v : A → V s) :
    sourceKPLocalCompactSeedOrbit K hζ P s v =
      Submodule.span ℂ (Set.range (fun a : Q × A => ρ s (d₀ a.1.out) (v a.2))) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨b,i⟩,rfl⟩
    have hi : ρ s b (v i) ∈ sourceKPLocalCompactBorelOrbit K hζ P s (v i) :=
      Submodule.subset_span ⟨b,rfl⟩
    rw [sourceKPLocalCompactBorelOrbit_eq_cube_span K hζ P s] at hi
    refine (Submodule.span_le.mpr ?_) hi
    rintro _ ⟨c,rfl⟩
    exact Submodule.subset_span ⟨(c,i),rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨c,i⟩,rfl⟩
    exact sourceKPLocalCompactSeedOrbit_translate_mem K hζ P s v (d₀ c.out) i

theorem sourceKPLocalCompactSeedOrbit_invariant {A : Type*} (s : ℂ) (v : A → V s) (b : B)
    (x : V s) (hx : x ∈ sourceKPLocalCompactSeedOrbit K hζ P s v) :
    ρ s b x ∈ sourceKPLocalCompactSeedOrbit K hζ P s v := by
  change x ∈ Submodule.span ℂ (Set.range (fun a : B × A => ρ s a.1 (v a.2))) at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨a,i⟩,rfl⟩ := hx
    change ρ s b (ρ s a (v i)) ∈ sourceKPLocalCompactSeedOrbit K hζ P s v
    rw [← Module.End.mul_apply, ← map_mul]
    exact sourceKPLocalCompactSeedOrbit_translate_mem K hζ P s v (b*a) i
  | zero =>
    simpa only [map_zero] using (sourceKPLocalCompactSeedOrbit K hζ P s v).zero_mem
  | add x y _ _ hx hy =>
    simpa only [map_add] using (sourceKPLocalCompactSeedOrbit K hζ P s v).add_mem hx hy
  | smul a x _ hx =>
    simpa only [map_smul] using (sourceKPLocalCompactSeedOrbit K hζ P s v).smul_mem a hx

theorem sourceKPLocalCompactSeedOrbit_finiteDimensional {A : Type*} [Finite A]
    (s : ℂ) (v : A → V s) : FiniteDimensional ℂ (sourceKPLocalCompactSeedOrbit K hζ P s v) := by
  let : Finite Q := sourceKPLocalCompactCubeClasses_finite K P
  change Module.Finite ℂ (sourceKPLocalCompactSeedOrbit K hζ P s v)
  rw [sourceKPLocalCompactSeedOrbit_eq_cube_span K hζ P s v]
  exact Module.Finite.span_of_finite ℂ (Set.finite_range _)

theorem sourceKPLocalCompactSeedOrbit_finrank_le {A : Type*} [Finite A]
    (s : ℂ) (v : A → V s) :
    Module.finrank ℂ (sourceKPLocalCompactSeedOrbit K hζ P s v) ≤ Nat.card Q * Nat.card A := by
  let : Finite Q := sourceKPLocalCompactCubeClasses_finite K P
  let : Fintype (Q × A) := Fintype.ofFinite _
  let f : Q × A → V s := fun a => ρ s (d₀ a.1.out) (v a.2)
  let : Fintype (Set.range f) := Fintype.ofFinite _
  rw [sourceKPLocalCompactSeedOrbit_eq_cube_span K hζ P s v, ← Nat.card_prod]
  change Module.finrank ℂ (Submodule.span ℂ (Set.range f)) ≤ Nat.card (Q × A)
  refine (finrank_span_le_card (Set.range f)).trans ?_
  rw [Set.toFinset_card, Nat.card_eq_fintype_card]
  convert Fintype.card_range_le f

local instance sourceKPLocalCompactSeedOrbitAddCommGroup {A : Type*} (s : ℂ) (v : A → V s) :
    AddCommGroup (sourceKPLocalCompactSeedOrbit K hζ P s v) := Submodule.addCommGroup _

def sourceKPLocalCompactSeedOrbitRepresentation {A : Type*} (s : ℂ) (v : A → V s) :
    Representation ℂ B (sourceKPLocalCompactSeedOrbit K hζ P s v) where
  toFun b := (ρ s b).restrict (sourceKPLocalCompactSeedOrbit_invariant K hζ P s v b)
  map_one' := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ρ s 1 x.val = x.val
    rw [map_one]
    rfl
  map_mul' b a := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ρ s (b*a) x.val = ρ s b (ρ s a x.val)
    rw [map_mul]
    rfl

theorem sourceKPLocalCompactSeedOrbit_induced_mem (s : ℂ)
    (f : sourceKPLocalCompactFixedSpace K hζ P (ρ s)) (g : G) :
    f.val.val g ∈ sourceKPLocalCompactSeedOrbit K hζ P s
      (sourceKPLocalCompactRestriction K hζ P (ρ s) f) := by
  obtain ⟨b,k,hg⟩ := sourceKPLocalCompactCover_Iwasawa K hζ P g
  let v : C ⧸ J → V s := sourceKPLocalCompactRestriction K hζ P (ρ s) f
  let f₀ : G → V s := f.val.val
  have hbk : f₀ (b.val*k.val) = ρ s b (v (QuotientGroup.mk k)) :=
    f.val.property b k.val
  have he : f₀ g = ρ s b (v (QuotientGroup.mk k)) := (congrArg f₀ hg).trans hbk
  change f₀ g ∈ sourceKPLocalCompactSeedOrbit K hζ P s v
  rw [he]
  exact sourceKPLocalCompactSeedOrbit_translate_mem K hζ P s v b (QuotientGroup.mk k)

end
