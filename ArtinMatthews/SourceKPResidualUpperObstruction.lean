module

public import ArtinMatthews.SourceKPAdelicRepresentativeAEStabilizer
public import ArtinMatthews.SourceKPAdelicRootCenter
public import ArtinMatthews.SourceKPTranslateGramCompactAE
public import ArtinMatthews.SourceKPAutomorphicEisensteinResidue


set_option backward.privateInPublic true
@[expose] public section

/-! Finite upper invariance forces a genuine vector to vanish, using the
actual Haar stabilizer and the cubic center generated by root subgroups. -/
namespace ArtinMatthews
open NumberField IsDedekindDomain MeasureTheory
open scoped NumberField AdeleRing MatrixGroups
noncomputable section

variable (K : Type) [Field K] [NumberField K] {ζ : K} (hζ : IsPrimitiveRoot ζ 12)
local notation "Y" => SourceKPAutomorphicCompactLevel K hζ
local notation "X" => SourceKPFiniteLevelSpace K hζ
local notation "Q" => sourceKPFiniteLevelToCompact K hζ
local notation "ν" => sourceKPFiniteRepresentativeHaar K hζ
local notation "μY" => sourceKPAutomorphicCompactMeasure K hζ (sourceKPArchHaar K hζ)
local notation "H" => SourceKPGenuineAutomorphicL2 K hζ

private theorem finiteLevelToCompact_center (z : rootsOfUnity 3 K) (x : X) :
    Q (sourceKPAdelicProjectiveCenter K hζ z • x) = z • Q x := rfl

theorem sourceKPGenuineAutomorphicL2_eq_zero_of_finite_upper_ae
    (P : HeightOneSpectrum (𝓞 K)) (f : H)
    (hN : ∀ u : 𝔸ᶠ[K], ∀ᵐ x ∂ν,
      f.val (Q (sourceKPAdelicUpperLift K hζ (0,u) • x)) = f.val (Q x)) : f = 0 := by
  let W : Y → ℂ := f.val
  let A := sourceKPAutomorphicCompactAEStabilizer K hζ W
  obtain ⟨z,hz,hA⟩ := sourceKPAdelicRootCenter_mem_of_upper_weyl K hζ P A hN
    (sourceKPAutomorphicCompactAEStabilizer_mem_weyl K hζ W)
  have hinv := (sourceKPAutomorphicCompactAEStabilizer_mem_iff K hζ W
    (sourceKPAdelicProjectiveCenter K hζ z)).mp hA
  have hχ := (sourceKPCompactGenuineL2Subspace_mem_ae K hζ (sourceKPArchHaar K hζ) f.val).mp f.prop z
  have hχQ := (sourceKPFiniteLevelToCompact_full_quasiMeasurePreserving K hζ).ae hχ
  have hzero : ∀ᵐ x ∂ν, W (Q x) = 0 := by
    filter_upwards [hinv,hχQ] with x hx hy
    change W (Q (sourceKPAdelicProjectiveCenter K hζ z • x)) = W (Q x) at hx
    change W (z • Q x) = (sourceKPAdelicCentralComplex K hζ z : ℂ) * W (Q x) at hy
    rw [finiteLevelToCompact_center] at hx
    have hprod : ((sourceKPAdelicCentralComplex K hζ z : ℂ)-1)*W (Q x) = 0 := by
      rw [sub_mul,one_mul,← hy,hx,sub_self]
    exact (mul_eq_zero.mp hprod).resolve_left (sub_ne_zero.mpr hz)
  have hY : (f.val : Y → ℂ) =ᵐ[μY] 0 :=
    sourceKPFiniteLevelToCompact_ae_of_comp K hζ (p := fun y => W y = 0) hzero
  apply Subtype.ext
  apply Lp.ext
  exact hY.trans (Lp.coeFn_zero ℂ 2 μY).symm

theorem sourceKPAutomorphicExceptionalResidue_not_finite_upper_ae
    (P : HeightOneSpectrum (𝓞 K)) {T : ℝ} (hT : 1 ≤ T) :
    ¬ ∀ u : 𝔸ᶠ[K], ∀ᵐ x ∂ν,
      (sourceKPAutomorphicExceptionalResidue K hζ hT).val
        (Q (sourceKPAdelicUpperLift K hζ (0,u) • x)) =
      (sourceKPAutomorphicExceptionalResidue K hζ hT).val (Q x) := by
  intro hN
  exact sourceKPAutomorphicExceptionalResidue_ne_zero K hζ hT
    (sourceKPGenuineAutomorphicL2_eq_zero_of_finite_upper_ae K hζ P
      (sourceKPAutomorphicExceptionalResidue K hζ hT) hN)

end
end ArtinMatthews
