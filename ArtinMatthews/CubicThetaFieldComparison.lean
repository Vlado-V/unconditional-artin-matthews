/-!
# Comparing the two concrete cyclotomic base-field models

The Hecke source uses `CyclotomicField 3 ℚ`; the Kummer construction uses the
actual intermediate field of `ℂ` generated by `exp(2πi/3)`. Cyclotomic-extension
uniqueness gives an algebra isomorphism, and hence an isomorphism of their
rings of integers. No orientation of the chosen primitive root is asserted.
-/
noncomputable section

namespace ArtinMatthews

/-- An actual rational algebra isomorphism between the Hecke and Kummer models
of the cubic cyclotomic base field. -/
def heckeCyclotomicEquiv :
    OAI.SevenEighths.HeckeFamily.K ≃ₐ[ℚ] cubicCyclotomicField :=
  IsCyclotomicExtension.algEquiv {3} ℚ _ _

/-- The same field comparison on algebraic integers. -/
def heckeCyclotomicIntegersEquiv :
    OAI.SevenEighths.HeckeFamily.O ≃+* NumberField.RingOfIntegers cubicCyclotomicField :=
  NumberField.RingOfIntegers.mapRingEquiv heckeCyclotomicEquiv.toRingEquiv

end ArtinMatthews
