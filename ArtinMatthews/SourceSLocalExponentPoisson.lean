/-! The genuine exterior prime coordinates supply every modulus, local
valuation and norm in the literal completion Poisson formula. -/
namespace ArtinMatthews.SourcePhysical

open NumberField IsDedekindDomain FractionalIdeal AllowedGenerators SIntegerPrincipalization
open VaryingKummerAnalytic StandardAdelic
open scoped NumberField Classical nonZeroDivisors BigOperators
noncomputable section
variable (F : Type) [Field F] [NumberField F]
variable (S₀ : Finset (HeightOneSpectrum (𝓞 F)))

local notation "FI" => FractionalIdeal (𝓞 F)⁰ F
local notation "S" => sourceHilbertSet F S₀
local notation "T" => sourceHilbertSeed F S₀
local notation "R" => sourceRing F S₀
local notation "M" => sourcePrimeExponentIdeal F S₀
local notation "q" => sourcePrimeExponentNorm F S₀

theorem sourcePrimeExponentIdeal_count_exterior (e : SourcePrimeExponents F S₀)
    (P : SourceExteriorPrime F S₀) :
    FractionalIdeal.count F P.val (M e : FI) = (e P : ℤ) := by
  have hprod : (M e : FI) = ∏ Q ∈ e.support, (Q.val.asIdeal : FI) ^ e Q := by
    change (coeIdealHom (𝓞 F)⁰ F) (∏ Q ∈ e.support, Q.val.asIdeal ^ e Q) = _
    rw [map_prod]
    exact Finset.prod_congr rfl (fun Q _ => (coeIdealHom (𝓞 F)⁰ F).map_pow Q.val.asIdeal (e Q))
  rw [hprod, FractionalIdeal.count_prod F P.val _ _ (fun Q _ =>
    pow_ne_zero _ (FractionalIdeal.coeIdeal_ne_zero.mpr Q.val.ne_bot)),
    Finset.sum_eq_single P]
  · exact FractionalIdeal.count_pow_self F P.val _
  · intro Q _ hQP
    rw [FractionalIdeal.count_pow F P.val,
      FractionalIdeal.count_maximal_coprime F P.val (fun he => hQP (Subtype.ext he)), mul_zero]
  · intro hP
    rw [Finsupp.notMem_support_iff.mp hP, pow_zero, FractionalIdeal.count_one]

variable [IsTotallyComplex F] {ζ : F} (hζ : IsPrimitiveRoot ζ 12)

local notation "a" => sourcePrimeExponentGenerator F hζ S₀

/-- Periodic Poisson on the source modulus generated by (sA), with the
literal completion test and the exact product of the two ideal norms. -/
theorem sourceSLocalExponentPeriodicPoisson (htrace : traceBadPlaces F ⊆ S)
    (s A : SourcePrimeExponents F S₀)
    (w : R ⧸ Ideal.span {a s * a A} → ℂ) (t : SWholeUnits F S) :
    (∑' x : R, w (Ideal.Quotient.mk _ x) * sourceSLocalCompletionProbe F S
      (sLocalRingDiagonal F S (x : F) * sourceSLocalUnitAdditivePoint F S t⁻¹)) =
      ((sLocalNorm F S t : ℂ) / ((q s : ℂ) * (q A : ℂ))) *
        ∑' h : R, sourceSLocalCompletionFourier F S (sourceSLocalCompletionProbe F S)
          (sourceSLocalUnitAdditivePoint F S t * sLocalRingDiagonal F S ((h : F) / ((a s * a A : R) : F))) *
          sourcePrincipalQuotientFourier F T (a s * a A)
            (sourcePrimeExponentGenerator_add F hζ S₀ s A ▸
              sourcePrimeExponentGenerator_ne_zero F hζ S₀ (s + A)) w h := by
  have ha : a s * a A ≠ (0 : R) :=
    sourcePrimeExponentGenerator_add F hζ S₀ s A ▸
      sourcePrimeExponentGenerator_ne_zero F hζ S₀ (s + A)
  have hgen : (M (s + A)).map (algebraMap (𝓞 F) R) = Ideal.span {a s * a A} := by
    rw [sourcePrimeExponentGenerator_ideal F hζ S₀ (s + A), sourcePrimeExponentGenerator_add]
  have hv (P : HeightOneSpectrum (𝓞 F)) (hP : P ∉ S) :
      P.valuation F ((a s * a A : R) : F) =
        WithZero.exp (-FractionalIdeal.count F P (M (s + A) : FI)) := by
    calc
      _ = P.valuation F (a (s + A) : F) :=
        congrArg (fun x : R => P.valuation F (x : F)) (sourcePrimeExponentGenerator_add F hζ S₀ s A).symm
      _ = WithZero.exp (-((s + A) ⟨P, hP⟩ : ℤ)) :=
        sourcePrimeExponentGenerator_valuation F hζ S₀ (s + A) ⟨P, hP⟩
      _ = _ := by rw [sourcePrimeExponentIdeal_count_exterior F S₀ (s + A) ⟨P, hP⟩]
  have h := sourceSLocalCompletionPeriodicPoisson F T (M (s + A))
    (sourcePrimeExponentIdeal_ne_bot F S₀ (s + A))
    (sourcePrimeExponentIdeal_exterior F S₀ (s + A)).2 htrace (a s * a A) ha hgen hv w t
  rw [sourcePrimeExponentIdeal_norm F S₀ (s + A), sourcePrimeExponentNorm_add, Nat.cast_mul] at h
  exact h

end
