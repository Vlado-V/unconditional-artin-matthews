module

public import ArtinMatthews.ShiftedConvolutionSmooth
public import ArtinMatthews.ShiftedSourceBessel


set_option backward.privateInPublic true
@[expose] public section

/-! Exact identification of the Fourier log phases generated by the genuine
kernel separation with the imaginary powers in (5.6), including the 2π height
rescaling and the harmless unit-modulus dyadic normalization factor. -/

noncomputable section
open Complex UpperHalfPlane Real Set OAI
open scoped ContDiff

namespace ArtinMatthews

/-- The Fourier convention gives Mellin height −2πt. -/
theorem logPhase_log_eq_shiftedMellin (t x : ℝ) :
    FourierBridge.logPhase t (Real.log x) = shiftedMellinPhase (-(2*Real.pi*t)) x := by
  unfold FourierBridge.logPhase shiftedMellinPhase
  congr 1
  push_cast
  ring

theorem norm_shifted_logPhase (t x : ℝ) : ‖FourierBridge.logPhase t x‖ = 1 := by
  simp [FourierBridge.logPhase,Complex.norm_exp]

/-- Dividing by the dyadic length contributes only a constant unit phase. -/
theorem logPhase_log_div_eq (t x K : ℝ) (hx : 0 < x) (hK : 0 < K) :
    FourierBridge.logPhase t (Real.log (x/K)) =
      FourierBridge.logPhase t (-Real.log K) * shiftedMellinPhase (-(2*Real.pi*t)) x := by
  rw [Real.log_div hx.ne' hK.ne',sub_eq_add_neg,FourierBridge.logPhase_add,
    logPhase_log_eq_shiftedMellin,mul_comm]

/-- The literal convolution coefficient norm after log-Fourier separation.
Both generated Fourier heights are accommodated by the already proved (5.6),
with the 2π rescaling absorbed into a fixed constant. -/
theorem weightOne_logPhaseConvolution_norm
    {Γ : Subgroup (GL (Fin 2) ℝ)} [Γ.IsArithmetic]
    (f : CuspForm Γ 1) (hperiod : (1 : ℝ) ∈ Γ.strictPeriods)
    (w1 w2 : ℝ → ℂ) (hs1 : ContDiff ℝ ∞ w1) (hs2 : ContDiff ℝ ∞ w2)
    (hw1 : Function.support w1 ⊆ Icc 1 2) (hw2 : Function.support w2 ⊆ Icc 1 2)
    (ν : ℝ) (hν : 0 < ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (K1 K2 t1 t2 : ℝ), 1 ≤ K1 → 1 ≤ K2 →
      ∀ (m3 m4 D : ℕ) [NeZero D], 0 < m4 →
        Real.sqrt (∑' r : ℤ, ‖shiftedConvolutionCoeff
          (Finset.range (shiftedDyadicLength K1)) (Finset.range (shiftedDyadicLength K2)) m3 m4 D
          (fun n ↦ (qExpansion 1 f).coeff n * w1 ((n : ℝ)/K1) * FourierBridge.logPhase t1 (Real.log n))
          (fun n ↦ (qExpansion 1 f).coeff n * w2 ((n : ℝ)/K2) * FourierBridge.logPhase t2 (Real.log n)) r‖^2) ≤
            C*(K1*K2)^((1+ν)/2)*(1+|t1|+|t2|)^2 := by
  obtain ⟨C,hC,hb⟩ := weightOne_smooth_dyadicConvolution_norm f hperiod w1 w2 hs1 hs2 hw1 hw2 ν hν
  refine ⟨C*(1+2*Real.pi)^2,by positivity,?_⟩
  intro K1 K2 t1 t2 hK1 hK2 m3 m4 D inst hm4
  have hc (w : ℝ → ℂ) (K t : ℝ) :
      (fun n : ℕ ↦ (qExpansion 1 f).coeff n * w ((n : ℝ)/K) * FourierBridge.logPhase t (Real.log n)) =
      fun n : ℕ ↦ (qExpansion 1 f).coeff n * shiftedDyadicWeight w K (-(2*Real.pi*t)) n := by
    funext n
    rw [logPhase_log_eq_shiftedMellin]
    unfold shiftedDyadicWeight
    ring
  rw [hc w1 K1 t1,hc w2 K2 t2]
  apply (hb K1 K2 (-(2*Real.pi*t1)) (-(2*Real.pi*t2)) hK1 hK2 m3 m4 D hm4).trans
  have hheight : 1+|-(2*Real.pi*t1)|+|-(2*Real.pi*t2)| ≤
      (1+2*Real.pi)*(1+|t1|+|t2|) := by
    simp only [abs_neg,abs_mul,abs_of_pos Real.pi_pos,abs_of_pos (by norm_num : (0 : ℝ)<2)]
    nlinarith [abs_nonneg t1,abs_nonneg t2,Real.pi_pos]
  calc
    _ ≤ C*(K1*K2)^((1+ν)/2)*((1+2*Real.pi)*(1+|t1|+|t2|))^2 := by
      apply mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hheight 2) (by positivity)
    _ = _ := by ring

end ArtinMatthews
